# -----------------------------------------------------------------------------
# DERIVATION CHAINS (What came from what)
# -----------------------------------------------------------------------------

# Key derivation relationships
lcls:tmo_v3_classifications prov:wasDerivedFrom lcls:tmo_v2_classifications,
                                                lcls:validation_results ;
                           prov:wasInfluencedBy lcls:human_validation_activity .

lcls:comprehensive_analysis_report prov:wasDerivedFrom lcls:tmo_v1_classifications,
                                                      lcls:tmo_v2_classifications,
                                                      lcls:tmo_v3_classifications,
                                                      lcls:validation_results .

# Attribution chains
