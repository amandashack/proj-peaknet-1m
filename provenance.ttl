                   prov:wasInfluencedBy lcls:ajshack .

lcls:validation_results prov:wasAttributedTo lcls:ajshack .

lcls:tmo_v3_prompt prov:wasAttributedTo lcls:claude_code ;
                   prov:wasInfluencedBy lcls:validation_results,
                                       lcls:ajshack .

