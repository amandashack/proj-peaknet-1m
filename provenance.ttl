@prefix tmo: <https://lcls.slac.stanford.edu/tmo/ns/> .
@prefix git: <https://github.com/ns/> .

# =============================================================================
# TMO Classification System Development - Complete Provenance Record
# =============================================================================

# -----------------------------------------------------------------------------
# AGENTS (Who)
# -----------------------------------------------------------------------------

lcls:ajshack a prov:Person, prov:Agent ;
    foaf:name "ajshack" ;
    prov:actedOnBehalfOf lcls:stanford_university .

lcls:claude_code a prov:SoftwareAgent ;
    foaf:name "Claude Code" ;
    prov:actedOnBehalfOf lcls:anthropic .

lcls:stanford_ai_gateway a prov:SoftwareAgent ;
    foaf:name "Stanford AI Gateway" ;
    prov:actedOnBehalfOf lcls:stanford_university .

lcls:stanford_university a prov:Organization ;
    foaf:name "Stanford University" .

lcls:anthropic a prov:Organization ;
    foaf:name "Anthropic" .

# -----------------------------------------------------------------------------
# INITIAL DATA AND SETUP
# -----------------------------------------------------------------------------

# Original SQLite database
lcls:logbook_database_2025_0813 a prov:Entity ;
    prov:label "LCLS Logbook Database 2025-08-13" ;
    prov:generatedAtTime "2025-08-13T22:57:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo lcls:lcls_daq_system ;
    prov:atLocation "/sdf/data/lcls/ds/prj/prjcwang31/results/proj-peaknet-1m/2025_0813_2257.db" .

# Initial codebase analysis request
lcls:codebase_analysis_request a prov:Activity ;
    prov:label "Initial codebase analysis and CLAUDE.md creation" ;
    prov:startedAtTime "2025-09-19T16:19:18Z"^^xsd:dateTime ;
    prov:wasAssociatedWith lcls:ajshack, lcls:claude_code .

# Git repository state
lcls:git_repo_initial a prov:Entity ;
    prov:label "Initial Git Repository State" ;
    git:commit "f522df5" ;
    git:branch "main" ;
    prov:generatedAtTime "2025-09-19T16:19:18Z"^^xsd:dateTime .

# -----------------------------------------------------------------------------
# PREPROCESSING PHASE
# -----------------------------------------------------------------------------

# Preprocessed experiment data
lcls:tmox1016823_enrichment a prov:Entity ;
    prov:label "TMO experiment tmox1016823 preprocessed data" ;
    prov:atLocation "processed_experiments/tmox1016823_enrichment.md" ;
    prov:wasDerivedFrom lcls:logbook_database_2025_0813 .

lcls:tmol1034523_enrichment a prov:Entity ;
    prov:label "TMO experiment tmol1034523 preprocessed data" ;
    prov:atLocation "processed_experiments/tmol1034523_enrichment.md" ;
    prov:wasDerivedFrom lcls:logbook_database_2025_0813 .

lcls:preprocessing_activity a prov:Activity ;
    prov:label "Logbook data preprocessing" ;
    prov:used lcls:logbook_database_2025_0813 ;
    prov:generated lcls:tmox1016823_enrichment, lcls:tmol1034523_enrichment ;
    prov:wasAssociatedWith lcls:claude_code ;
    prov:startedAtTime "2025-09-19T17:30:00Z"^^xsd:dateTime .

# -----------------------------------------------------------------------------
# TMO v1 DEVELOPMENT
# -----------------------------------------------------------------------------

# Original LCLS prompt
lcls:original_lcls_prompt a prov:Entity ;
    prov:label "Original LCLS Classification Prompt" ;
    tmo:categories "sample_run, calibration_run, alignment_run, test_run, commissioning_run, unknown_run" ;
    prov:wasAttributedTo lcls:original_system_developers .

# TMO-specific analysis
lcls:tmo_domain_analysis a prov:Activity ;
    prov:label "TMO domain analysis and requirements gathering" ;
    prov:startedAtTime "2025-09-19T18:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith lcls:claude_code ;
    prov:used lcls:tmo_documentation .

lcls:tmo_documentation a prov:Entity ;
    prov:label "TMO Shift Plans and Documentation" ;
    prov:wasAttributedTo lcls:tmo_beamline_team .

# TMO v1 prompt creation
lcls:tmo_v1_prompt a prov:Entity ;
    prov:label "TMO v1 Classification Prompt" ;
    tmo:categories "commissioning_run, alignment_run, timing_run, calibration_run, measurement_run, diagnostic_run, unknown_run" ;
    prov:wasRevisionOf lcls:original_lcls_prompt ;
    prov:wasDerivedFrom lcls:tmo_domain_analysis ;
    prov:wasAttributedTo lcls:claude_code ;
    prov:generatedAtTime "2025-09-19T20:00:00Z"^^xsd:dateTime .

# Git branch for v1
lcls:git_branch_tmo_v1 a prov:Entity ;
    prov:label "Git Branch wip/tmo_prompt_v1" ;
    git:branch "wip/tmo_prompt_v1" ;
    prov:wasDerivedFrom lcls:git_repo_initial ;
    prov:generatedAtTime "2025-09-20T10:00:00Z"^^xsd:dateTime .

# TMO v1 classification run
lcls:tmo_v1_classification_activity a prov:Activity ;
    prov:label "TMO v1 Classification of tmox1016823" ;
    prov:used lcls:tmox1016823_enrichment, lcls:tmo_v1_prompt ;
    prov:wasAssociatedWith lcls:stanford_ai_gateway ;
    prov:startedAtTime "2025-09-20T14:30:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2025-09-20T14:45:00Z"^^xsd:dateTime ;
    tmo:model "claude-3-7-sonnet" ;
    tmo:temperature "0.1" ;
    tmo:total_tokens "108877" .

lcls:tmo_v1_classifications a prov:Entity ;
    prov:label "TMO v1 Classification Results for tmox1016823" ;
    prov:atLocation "results/tmo_v1/classifications/tmox1016823_classifications.json" ;
    prov:wasGeneratedBy lcls:tmo_v1_classification_activity ;
    tmo:total_runs "377" ;
    tmo:accuracy_estimate "79%" .

# -----------------------------------------------------------------------------
# VALIDATION PHASE
# -----------------------------------------------------------------------------

# Validation application setup
lcls:validation_app_update a prov:Activity ;
    prov:label "Update validation app with TMO categories" ;
    prov:wasAssociatedWith lcls:claude_code ;
    prov:used lcls:validation_app_original ;
    prov:generated lcls:validation_app_tmo ;
    prov:startedAtTime "2025-09-20T16:00:00Z"^^xsd:dateTime .

lcls:validation_app_tmo a prov:Entity ;
    prov:label "TMO-enabled validation application" ;
    prov:atLocation "/sdf/scratch/users/a/ajshack/dev/run-classification-validation-app/" ;
    prov:wasDerivedFrom lcls:validation_app_original .

# Human validation process
lcls:human_validation_activity a prov:Activity ;
    prov:label "Human validation of TMO v1 classifications" ;
    prov:used lcls:tmo_v1_classifications ;
    prov:wasAssociatedWith lcls:ajshack ;
    prov:startedAtTime "2025-09-19T16:19:18Z"^^xsd:dateTime ;
    prov:endedAtTime "2025-09-21T14:03:39Z"^^xsd:dateTime .

lcls:validation_results a prov:Entity ;
    prov:label "Human validation results for tmox1016823" ;
    prov:atLocation "results/tmo_v1/validations/tmox1016823_full_enrichment_validation.json" ;
    prov:wasGeneratedBy lcls:human_validation_activity ;
    tmo:total_runs "377" ;
    tmo:corrections_made "79" ;
    tmo:accuracy_rate "79.04509283819628" .

# Performance analysis
lcls:v1_performance_analysis a prov:Activity ;
    prov:label "TMO v1 performance analysis" ;
    prov:used lcls:tmo_v1_classifications, lcls:validation_results ;
    prov:wasAssociatedWith lcls:claude_code ;
    prov:generated lcls:v1_performance_report .

lcls:v1_performance_report a prov:Entity ;
    prov:label "TMO v1 Performance Analysis Report" ;
    prov:atLocation "results/tmo_v1/TMO_Performance_Comparison_tmox1016823.md" ;
    prov:wasGeneratedBy lcls:v1_performance_analysis .

