    prov:startedAtTime "2025-09-21T22:46:37Z"^^xsd:dateTime ;
    prov:endedAtTime "2025-09-21T22:56:00Z"^^xsd:dateTime ;
    tmo:model "claude-3-7-sonnet" ;
